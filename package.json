{
  "name": "mflocss-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.css\" --fix",
    "lint:js": "eslint \"src/**/*.js\" \"public/**/*.js\" --fix",
    "lint:html": "markuplint \"src/**/*.html\"",
    "format": "prettier --write .",
    "check": "npm run format && npm run lint:css && npm run lint:js && npm run lint:html"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "markuplint": "^4.18.1",
    "prettier": "^3.0.0",
    "stylelint": "^17.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.5"
  },
  "overrides": {
    "uuid": ">=14.0.0",
    "fast-uri": ">=3.1.2",
    "brace-expansion": ">=5.0.6"
  },
  "pnpm": {
    "overrides": {
      "uuid": ">=14.0.0",
      "fast-uri": ">=3.1.2",
      "brace-expansion": ">=5.0.6"
    }
  }
}
