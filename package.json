{
  "name": "mflocss-starter",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.css\" --fix",
    "lint:js": "eslint \"src/**/*.js\" \"public/**/*.js\" --fix",
    "lint:html": "markuplint \"src/**/*.html\"",
    "format": "prettier --write .",
    "check": "npm run format && npm run lint:css && npm run lint:js && npm run lint:html"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "markuplint": "^5.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "~8.3.0"
  },
  "overrides": {
    "uuid": ">=14.0.0",
    "js-yaml": ">=5.2.2",
    "brace-expansion": ">=5.0.9",
    "fast-uri": ">=3.1.6 <4",
    "postcss": ">=8.5.18",
    "image-size": ">=2.0.3"
  },
  "pnpm": {
    "overrides": {
      "uuid": ">=14.0.0",
      "js-yaml": ">=5.2.2",
      "brace-expansion": ">=5.0.9",
      "fast-uri": ">=3.1.6 <4",
      "postcss": ">=8.5.18",
      "image-size": ">=2.0.3"
    }
  }
}
